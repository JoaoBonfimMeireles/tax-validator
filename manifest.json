{
  "vendor": "teste",
  "name": "tax-validator",
  "version": "0.1.0",
  "title": "Validador de Impostos (SAP)",
  "description": "Consulta a Tax API Whirlpool com dados do catálogo, simulação e logística da VTEX",
  "builders": {
    "react": "3.x",
    "admin": "0.x",
    "messages": "1.x",
    "docs": "0.x",
    "node": "7.x"
  },
  "dependencies": {
    "vtex.styleguide": "9.x"
  },
  "policies": [
    {
      "name": "outbound-access",
      "attrs": {
        "host": "api.whirlpool.com",
        "path": "*"
      }
    },
    {
      "name": "outbound-access",
      "attrs": {
        "host": "{{account}}.vtexcommercestable.com.br",
        "path": "*"
      }
    }
  ],
  "billingOptions": {
    "type": "free",
    "support": {
      "url": "https://www.vtex.com.br"
    },
    "availableCountries": ["*"]
  },
  "settingsSchema": {
    "title": "Validador de Impostos (Tax API Whirlpool)",
    "type": "object",
    "properties": {
      "basicAuth": {
        "title": "BASIC (client_id:secret em Base64)",
        "type": "string",
        "access": "private"
      },
      "tokenUrl": {
        "title": "URL do token",
        "type": "string",
        "default": "https://api.whirlpool.com/oauth2/v1/token"
      },
      "taxUrl": {
        "title": "URL da Tax API",
        "type": "string",
        "default": "https://api.whirlpool.com/d2c/v1/merx2/ecc-service/tax-api"
      }
    }
  },
  "$schema": "https://raw.githubusercontent.com/vtex/node-vtex-api/master/gen/manifest.schema"
}
